<?xml version="1.0"?>
<package format="3">
  <name>robot_run_ros</name>
  <version>1.0.0</version>
  <description>ROS 2 bridge for the Robot Run teaching simulator.</description>
  <maintainer email="elena.villalba@upc.edu">Elena Villalba</maintainer>
  <license>Educational use within Intelligent Robotics at UPC-EEBE</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-pygame</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

